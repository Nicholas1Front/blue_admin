 
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employeeObligationsReviewed EmployeeObligation[] @relation("EmployeeObligationReviewer")
  employeeMovementsCreated    EmployeeMovement[]   @relation("EmployeeMovementActor")
  employeeHistoryCreated      EmployeeHistory[]    @relation("EmployeeHistoryActor")
}

model Client {
  id          String          @id @default(uuid())
  name        String
  document    String?         @db.VarChar(14)
  address     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contacts    ClientContact[]
  equipaments Equipament[]
  services    Service[]
  budgets     Budget[]
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  name        String
  email       String?
  phoneNumber String   @map("phone_number")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Equipament {
  id                       String   @id @default(uuid())
  clientId                 String   @map("client_id")
  type                     String
  brand                    String
  model                    String?
  mainIdentification       String?  @map("main_identification")
  additionalIdentification String?  @map("additional_identification")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client                   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service                  Service[]
  budgets                  Budget[]

  @@map("equipaments")
}

model FinancialCategory {
  id           String                    @id @default(uuid())
  name         String
  description  String?
  type         String
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  transactions FinancialTransaction[]

  @@map("financial_categories")
}

model FinancialTransaction {
  id            String            @id @default(uuid())
  description   String
  value         Decimal
  type          String
  categoryId    String            @map("category_id")
  referenceDate DateTime          @map("reference_date")
  originType    String?           @map("origin_type")
  originId      String?           @map("origin_id")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  category       FinancialCategory @relation(fields: [categoryId], references: [id])
  titheForService  Service?         @relation("ServiceTitheTransaction")
  employeeMovement EmployeeMovement?

  @@index([categoryId])
  @@index([referenceDate])
  @@index([type])
  @@index([originType, originId])
  @@map("financial_transactions")
}

model MonthlyExpense {
  id            String    @id @default(uuid())
  name          String
  description   String?
  expectedValue Decimal   @map("expected_value")
  dueDate       DateTime? @map("due_date")
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@map("monthly_expenses")
}

model Service {
  id                 String      @id @default(uuid())
  clientId           String      @map("client_id")
  equipamentId       String      @map("equipament_id")
  entryDate          DateTime    @default(now()) @map("entry_date")
  exitDate           DateTime?   @map("exit_date")
  status             String
  hoursWorked        Decimal?    @map("hours_worked")
  costPerHour        Decimal?    @map("cost_per_hour")
  titheStatus        String?     @default("aguardando") @map("tithe_status")
  titheTransactionId String?     @unique @map("tithe_transaction_id")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  client            Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  equipament        Equipament            @relation(fields: [equipamentId], references: [id], onDelete: Restrict)
  history           ServiceHistory[]
  activities        ServiceActivity[]
  titheTransaction  FinancialTransaction?  @relation("ServiceTitheTransaction", fields: [titheTransactionId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([equipamentId])
  @@index([status])
  @@index([entryDate])
  @@map("services")
}

model ServiceHistory {
  id          String   @id @default(uuid())
  serviceId   String   @map("service_id")
  eventType   String   @map("event_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@map("services_history")
}

model ServiceActivity {
  id          String    @id @default(uuid())
  serviceId   String    @map("service_id")
  title       String
  description String?
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  status      String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("services_activities")
}

model Budget {
  id               String         @id @default(uuid())
  clientId         String         @map("client_id")
  equipamentId     String         @map("equipament_id")
  validity         String         @default("7 dias")
  warranty         String         @default("30 dias")
  deliveryTime     String         @default("7 dias") @map("delivery_time")
  paymentCondition String         @default("À vista") @map("payment_condition")
  observations     String?
  totalAmount      Decimal        @default(0) @map("total_amount")
  globalDiscount   Decimal        @default(0) @map("global_discount")
  finalAmount      Decimal        @default(0) @map("final_amount")
  status           String         @default("rascunho")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  client           Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  equipament       Equipament     @relation(fields: [equipamentId], references: [id], onDelete: Restrict)
  items            BudgetItem[]
  history          BudgetHistory[]

  @@index([clientId])
  @@index([equipamentId])
  @@index([status])
  @@index([createdAt])
  @@map("budgets")
}

model BudgetItem {
  id          String         @id @default(uuid())
  budgetId    String         @map("budget_id")
  title       String
  description String?
  categoryId  String         @map("category_id")
  quantity    Decimal
  unitValue   Decimal        @map("unit_value")
  totalAmount Decimal        @default(0) @map("total_amount")
  discount    Decimal        @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@index([categoryId])
  @@map("budget_items")
}

model BudgetCategory {
  id          String       @id @default(uuid())
  name        String
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  items       BudgetItem[]
  prices      BudgetPrice[]

  @@index([isActive])
  @@map("budget_categories")
}

model BudgetPrice {
  id          String         @id @default(uuid())
  categoryId  String         @map("category_id")
  title       String
  description String?
  unitValue   Decimal        @map("unit_value")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([title])
  @@index([createdAt])
  @@map("budget_prices")
}

model BudgetHistory {
  id          String   @id @default(uuid())
  budgetId    String   @map("budget_id")
  eventType   String   @map("event_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, createdAt])
  @@map("budgets_history")
}


model Vehicle {
  id               String   @id @default(uuid())
  title            String
  plate            String?  @unique
  renavam          String?  @unique
  crlv             String?
  crv              String?
  currentKilometer Int?     @map("current_kilometer")
  observations     String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  history VehicleHistory[]

  @@map("vehicles")
}

model VehicleHistory {
  id                String   @id @default(uuid())
  vehicleId         String   @map("vehicle_id")
  eventType         String   @map("event_type")
  description       String
  kilometerSnapshot Int?     @map("kilometer_snapshot")
  eventDate         DateTime @default(now()) @map("event_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, eventDate])
  @@index([eventType, eventDate])
  @@map("vehicles_history")
}



model Employee {
  id          String   @id @default(uuid())
  name        String
  cpfCnpj     String?  @map("cpf_cnpj") @db.VarChar(14)
  address     String?
  birthDate   DateTime? @map("birth_date")
  observations String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  engagements EmployeeEngagement[]
  history     EmployeeHistory[]

  @@index([name])
  @@map("employees")
}

model EmployeeEngagement {
  id                String    @id @default(uuid())
  employeeId        String    @map("employee_id")
  entryDate         DateTime  @map("entry_date")
  exitDate          DateTime? @map("exit_date")
  position          String?
  currentSalary     Decimal?  @map("current_salary")
  dailyHours        Decimal?  @map("daily_hours")
  modality          String
  status            String    @default("ativo")
  terminationReason String?   @map("termination_reason")
  noticeType        String?   @map("notice_type")
  noticeDate        DateTime? @map("notice_date")
  noticeEndDate     DateTime? @map("notice_end_date")
  observations      String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  obligations EmployeeObligation[]
  movements   EmployeeMovement[]
  history     EmployeeHistory[]

  @@index([employeeId, entryDate])
  @@index([status, entryDate])
  @@index([exitDate])
  @@map("employee_engagements")
}

model EmployeeObligation {
  id             String    @id @default(uuid())
  engagementId   String    @map("engagement_id")
  type           String
  title          String
  description    String?
  originalValue  Decimal?  @map("original_value")
  finalValue     Decimal?  @map("final_value")
  status         String    @default("em_revisao")
  referenceStart DateTime? @map("reference_start")
  referenceEnd   DateTime? @map("reference_end")
  dueDate        DateTime? @map("due_date")
  source         String    @default("manual")
  referenceKey   String?   @map("reference_key")
  calculationDetails Json? @map("calculation_details")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewedById   String?   @map("reviewed_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  engagement EmployeeEngagement          @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  reviewedBy User?                       @relation("EmployeeObligationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  movements  EmployeeMovement[]
  allocations EmployeePaymentAllocation[]

  @@unique([engagementId, referenceKey])
  @@index([engagementId, status, dueDate])
  @@index([type, referenceStart, referenceEnd])
  @@map("employee_obligations")
}

model EmployeeMovement {
  id                   String    @id @default(uuid())
  engagementId         String    @map("engagement_id")
  type                 String
  title                String
  description          String?
  value                Decimal?
  eventDate            DateTime  @map("event_date")
  transactionId        String?   @unique @map("transaction_id")
  obligationId         String?   @map("obligation_id")
  sourceMovementId     String?   @map("source_movement_id")
  durationMinutes      Int?      @map("duration_minutes")
  absenceDays          Decimal?  @map("absence_days")
  justificationStatus  String?   @map("justification_status")
  createdById          String?   @map("created_by_id")
  reversedAt           DateTime? @map("reversed_at")
  reversalReason       String?   @map("reversal_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  engagement         EmployeeEngagement          @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  financialTransaction FinancialTransaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  obligation         EmployeeObligation?          @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  sourceMovement     EmployeeMovement?            @relation("EmployeeAdvanceSource", fields: [sourceMovementId], references: [id], onDelete: Restrict)
  advanceApplications EmployeeMovement[]          @relation("EmployeeAdvanceSource")
  createdBy          User?                        @relation("EmployeeMovementActor", fields: [createdById], references: [id], onDelete: SetNull)
  allocations        EmployeePaymentAllocation[]

  @@index([engagementId, eventDate])
  @@index([type, eventDate])
  @@index([obligationId])
  @@index([sourceMovementId])
  @@map("employee_movements")
}

model EmployeePaymentAllocation {
  id           String   @id @default(uuid())
  movementId   String   @map("movement_id")
  obligationId String?  @map("obligation_id")
  type         String
  value        Decimal
  createdAt    DateTime @default(now()) @map("created_at")

  movement   EmployeeMovement   @relation(fields: [movementId], references: [id], onDelete: Restrict)
  obligation EmployeeObligation? @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  @@index([movementId])
  @@index([obligationId])
  @@index([type, createdAt])
  @@map("employee_payment_allocations")
}

model EmployeeHistory {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  engagementId String? @map("engagement_id")
  type        String
  title       String
  description String?
  metadata    Json?
  eventDate   DateTime @map("event_date")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  engagement EmployeeEngagement? @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("EmployeeHistoryActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, eventDate])
  @@index([engagementId, eventDate])
  @@index([type, eventDate])
  @@map("employee_history")
}
