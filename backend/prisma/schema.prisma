 
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notesCreated         Note[]             @relation("NoteCreatedBy")
  foldersCreated       NoteFolder[]       @relation("FolderCreatedBy")
  notificationsCreated Notification[]     @relation("NotificationCreatedBy")
  notificationReads    NotificationRead[]
}

model Client {
  id          String          @id @default(uuid())
  name        String
  document    String?         @db.VarChar(14)
  address     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contacts    ClientContact[]
  equipaments Equipament[]
  services    Service[]
  budgets     Budget[]
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  name        String
  email       String?
  phoneNumber String   @map("phone_number")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Equipament {
  id                       String   @id @default(uuid())
  clientId                 String   @map("client_id")
  type                     String
  brand                    String
  model                    String?
  mainIdentification       String?  @map("main_identification")
  additionalIdentification String?  @map("additional_identification")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client                   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service                  Service[]
  budgets                  Budget[]

  @@map("equipaments")
}

model FinancialCategory {
  id           String                    @id @default(uuid())
  name         String
  description  String?
  type         String
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  transactions FinancialTransaction[]

  @@map("financial_categories")
}

model FinancialTransaction {
  id            String            @id @default(uuid())
  description   String
  value         Decimal
  type          String
  categoryId    String            @map("category_id")
  referenceDate DateTime          @map("reference_date")
  originType    String?           @map("origin_type")
  originId      String?           @map("origin_id")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  category       FinancialCategory @relation(fields: [categoryId], references: [id])
  titheForService Service?         @relation("ServiceTitheTransaction")

  @@index([categoryId])
  @@index([referenceDate])
  @@index([type])
  @@index([originType, originId])
  @@map("financial_transactions")
}

model MonthlyExpense {
  id            String    @id @default(uuid())
  name          String
  description   String?
  expectedValue Decimal   @map("expected_value")
  dueDate       DateTime? @map("due_date")
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@map("monthly_expenses")
}

model Service {
  id                 String      @id @default(uuid())
  clientId           String      @map("client_id")
  equipamentId       String      @map("equipament_id")
  entryDate          DateTime    @default(now()) @map("entry_date")
  exitDate           DateTime?   @map("exit_date")
  status             String
  hoursWorked        Decimal?    @map("hours_worked")
  costPerHour        Decimal?    @map("cost_per_hour")
  titheStatus        String?     @default("aguardando") @map("tithe_status")
  titheTransactionId String?     @unique @map("tithe_transaction_id")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  client            Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  equipament        Equipament            @relation(fields: [equipamentId], references: [id], onDelete: Restrict)
  history           ServiceHistory[]
  activities        ServiceActivity[]
  titheTransaction  FinancialTransaction?  @relation("ServiceTitheTransaction", fields: [titheTransactionId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([equipamentId])
  @@index([status])
  @@index([entryDate])
  @@map("services")
}

model ServiceHistory {
  id          String   @id @default(uuid())
  serviceId   String   @map("service_id")
  eventType   String   @map("event_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@map("services_history")
}

model ServiceActivity {
  id          String    @id @default(uuid())
  serviceId   String    @map("service_id")
  title       String
  description String?
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  status      String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("services_activities")
}

model Budget {
  id               String         @id @default(uuid())
  clientId         String         @map("client_id")
  equipamentId     String         @map("equipament_id")
  validity         String         @default("7 dias")
  warranty         String         @default("30 dias")
  deliveryTime     String         @default("7 dias") @map("delivery_time")
  paymentCondition String         @default("À vista") @map("payment_condition")
  observations     String?
  totalAmount      Decimal        @default(0) @map("total_amount")
  globalDiscount   Decimal        @default(0) @map("global_discount")
  finalAmount      Decimal        @default(0) @map("final_amount")
  status           String         @default("rascunho")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  client           Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  equipament       Equipament     @relation(fields: [equipamentId], references: [id], onDelete: Restrict)
  items            BudgetItem[]
  history          BudgetHistory[]

  @@index([clientId])
  @@index([equipamentId])
  @@index([status])
  @@index([createdAt])
  @@map("budgets")
}

model BudgetItem {
  id          String         @id @default(uuid())
  budgetId    String         @map("budget_id")
  title       String
  description String?
  categoryId  String         @map("category_id")
  quantity    Decimal
  unitValue   Decimal        @map("unit_value")
  totalAmount Decimal        @default(0) @map("total_amount")
  discount    Decimal        @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@index([categoryId])
  @@map("budget_items")
}

model BudgetCategory {
  id          String       @id @default(uuid())
  name        String
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  items       BudgetItem[]
  prices      BudgetPrice[]

  @@index([isActive])
  @@map("budget_categories")
}

model BudgetPrice {
  id          String         @id @default(uuid())
  categoryId  String         @map("category_id")
  title       String
  description String?
  unitValue   Decimal        @map("unit_value")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([title])
  @@index([createdAt])
  @@map("budget_prices")
}

model BudgetHistory {
  id          String   @id @default(uuid())
  budgetId    String   @map("budget_id")
  eventType   String   @map("event_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, createdAt])
  @@map("budgets_history")
}


model Vehicle {
  id               String   @id @default(uuid())
  title            String
  plate            String?  @unique
  renavam          String?  @unique
  crlv             String?
  crv              String?
  currentKilometer Int?     @map("current_kilometer")
  observations     String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  history VehicleHistory[]

  @@map("vehicles")
}

model VehicleHistory {
  id                String   @id @default(uuid())
  vehicleId         String   @map("vehicle_id")
  eventType         String   @map("event_type")
  description       String
  kilometerSnapshot Int?     @map("kilometer_snapshot")
  eventDate         DateTime @default(now()) @map("event_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, eventDate])
  @@index([eventType, eventDate])
  @@map("vehicles_history")
}



model NoteFolder {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User   @relation("FolderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  notes     Note[]

  @@index([createdById])
  @@map("notes_folders")
}

model Note {
  id          String   @id @default(uuid())
  title       String
  content     String
  happenedAt  DateTime @default(now()) @map("happened_at")
  folderId    String?  @map("folder_id")
  createdById String   @map("created_by_id")
  isPinned    Boolean  @default(false) @map("is_pinned")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  folder       NoteFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  references   NoteReference[]
  notification Notification?

  @@index([folderId])
  @@index([createdById])
  @@index([happenedAt])
  @@index([isArchived, isPinned, updatedAt])
  @@map("notes")
}

model NoteReference {
  id         String   @id @default(uuid())
  noteId     String   @map("note_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("notes_references")
}

model Notification {
  id          String   @id @default(uuid())
  noteId      String   @unique @map("note_id")
  createdById String   @map("created_by_id")
  title       String
  message     String
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  note      Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdBy User                @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reads     NotificationRead[]

  @@index([expiresAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRead {
  id             String   @id @default(uuid())
  notificationId String   @map("notification_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notifications_reads")
}
