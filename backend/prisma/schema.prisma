 
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id          String          @id @default(uuid())
  name        String
  document    String?         @db.VarChar(14)
  address     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contacts    ClientContact[]
  equipaments Equipament[]
  services    Service[]
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  name        String
  email       String?
  phoneNumber String   @map("phone_number")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Equipament {
  id                       String   @id @default(uuid())
  clientId                 String   @map("client_id")
  type                     String
  brand                    String
  model                    String?
  mainIdentification       String?  @map("main_identification")
  additionalIdentification String?  @map("additional_identification")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client                   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service                  Service[]

  @@map("equipaments")
}

model FinancialCategory {
  id           String                    @id @default(uuid())
  name         String
  description  String?
  type         String
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  transactions FinancialTransaction[]

  @@map("financial_categories")
}

model FinancialTransaction {
  id            String            @id @default(uuid())
  description   String
  value         Decimal
  type          String
  categoryId    String            @map("category_id")
  referenceDate DateTime          @map("reference_date")
  originType    String?           @map("origin_type")
  originId      String?           @map("origin_id")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  category       FinancialCategory @relation(fields: [categoryId], references: [id])
  titheForService Service?         @relation("ServiceTitheTransaction")

  @@index([categoryId])
  @@index([referenceDate])
  @@index([type])
  @@index([originType, originId])
  @@map("financial_transactions")
}

model MonthlyExpense {
  id            String    @id @default(uuid())
  name          String
  description   String?
  expectedValue Decimal   @map("expected_value")
  dueDate       DateTime? @map("due_date")
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@map("monthly_expenses")
}

model Service {
  id                 String      @id @default(uuid())
  clientId           String      @map("client_id")
  equipamentId       String      @map("equipament_id")
  entryDate          DateTime    @default(now()) @map("entry_date")
  exitDate           DateTime?   @map("exit_date")
  status             String
  hoursWorked        Decimal?    @map("hours_worked")
  costPerHour        Decimal?    @map("cost_per_hour")
  titheStatus        String?     @default("aguardando") @map("tithe_status")
  titheTransactionId String?     @unique @map("tithe_transaction_id")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  client            Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  equipament        Equipament            @relation(fields: [equipamentId], references: [id], onDelete: Restrict)
  history           ServiceHistory[]
  activities        ServiceActivity[]
  titheTransaction  FinancialTransaction?  @relation("ServiceTitheTransaction", fields: [titheTransactionId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([equipamentId])
  @@index([status])
  @@index([entryDate])
  @@map("services")
}

model ServiceHistory {
  id          String   @id @default(uuid())
  serviceId   String   @map("service_id")
  eventType   String   @map("event_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@map("services_history")
}

model ServiceActivity {
  id          String    @id @default(uuid())
  serviceId   String    @map("service_id")
  title       String
  description String?
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  status      String    
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("services_activities")
}
